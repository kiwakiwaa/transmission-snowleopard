-- (instancetype)initByReferencingButtons:(NSArray<NSButton *> *)buttons
+static NSButton *SUCopyTouchBarButton(NSButton *button)
+{
+    NSButton *buttonCopy;
+    if ([NSButton respondsToSelector:
+            @selector(buttonWithTitle:target:action:)]) {
+        buttonCopy = [NSButton buttonWithTitle:[button title]
+            target:[button target] action:[button action]];
+    } else {
+        buttonCopy = [[NSButton alloc] initWithFrame:NSZeroRect];
+        [buttonCopy setButtonType:NSMomentaryPushInButton];
+        [buttonCopy setBezelStyle:NSRoundedBezelStyle];
+        [buttonCopy setTitle:[button title]];
+        [buttonCopy setTarget:[button target]];
+        [buttonCopy setAction:[button action]];
+    }
+    [buttonCopy setTag:[button tag]];
+    [buttonCopy setEnabled:[button isEnabled]];
+    return buttonCopy;
+}
