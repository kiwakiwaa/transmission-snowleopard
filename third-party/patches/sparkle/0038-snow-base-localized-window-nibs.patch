# Snow Leopard compatibility patch 0038
#
# Incompatibility: Snow Leopard does not resolve Sparkle's window-controller
# nib names through the newer Base.lproj localization convention. The compiled
# nibs are present, but controller loading from the framework localization
# directory returns no window and makes an accepted update disappear. The build
# graph places identical Snow-compiled nibs in a nonlocalized framework directory.
# Behaviour preserved: each controller remains the nib owner and AppKit connects
# the same window, bindings, actions, and zeroing-weak outlets. NSWindowController
# still invokes windowDidLoad after this bounded loadWindow override returns. The
# original loader remains the fallback when the pinned resource is absent.
# Public API evidence: NSBundle pathForResource:ofType:inDirectory: and
# loadNibFile:externalNameTable:withZone: are public 10.6 AppKit APIs.
diff --git a/Sparkle/SUAutomaticUpdateAlert.m b/Sparkle/SUAutomaticUpdateAlert.m
index 1e914dd3..5d409945 100644
--- a/Sparkle/SUAutomaticUpdateAlert.m
+++ b/Sparkle/SUAutomaticUpdateAlert.m
@@ -35,6 +35,24 @@
 @synthesize laterButton;
 @synthesize installButton;
 
+- (void)loadWindow
+{
+    NSString *nibPath = [[NSBundle bundleForClass:[self class]]
+        pathForResource:@"SUAutomaticUpdateAlert"
+                 ofType:@"nib"
+            inDirectory:@"LegacySnow"];
+    if (nibPath == nil) {
+        [super loadWindow];
+        return;
+    }
+    NSDictionary *nameTable = [NSDictionary dictionaryWithObject:self
+        forKey:NSNibOwner];
+    if (![NSBundle loadNibFile:nibPath externalNameTable:nameTable
+        withZone:nil]) {
+        [self setWindow:nil];
+    }
+}
+
 - (instancetype)initWithAppcastItem:(SUAppcastItem *)item host:(SUHost *)aHost completionBlock:(void (^)(SUAutomaticInstallationChoice))block
 {
     self = [super initWithWindowNibName:@"SUAutomaticUpdateAlert"];
