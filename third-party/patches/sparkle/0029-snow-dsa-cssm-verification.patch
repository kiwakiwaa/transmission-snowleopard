# Snow Leopard compatibility patch 0029
#
# Incompatibility: Security Transforms and SecItemImport are post-10.6 APIs,
# while Sparkle 1.27.3 still accepts and verifies DSA update signatures.
# Behaviour preserved: DSA keys remain PEM encoded, archives are hashed with
# SHA-1, and signatures fail closed for bad keys, data, encodings, or values.
# Ed25519 precedence and refusal policy remain exactly as in 1.27.3.
# History: ae728448 added a public CSSM fallback for pre-Lion systems. 697a3436
# removed it only as "Deleted 10.6 code" after support changed. Later security
# commit 2929333b affects Ed25519 precedence and remains untouched.
# Public API evidence: CSSM, Apple CSP, CommonCrypto SHA-1, and NSInputStream
# are public in the 10.6 SDK. The PEM decoder enforces patch 0017's rules.
# Safety: CSSM lifetime is serialised, all reads and API results are checked,
# the key parser accepts only canonical PEM/Base64, and every failure returns
# NO. No private selector, command, or external crypto tool is used.
diff --git a/Sparkle/SULegacyDSAVerifier.h b/Sparkle/SULegacyDSAVerifier.h
new file mode 100644
--- /dev/null
+++ b/Sparkle/SULegacyDSAVerifier.h
@@ -0,0 +1,9 @@
+#import <Foundation/Foundation.h>
+
+#ifndef SULEGACYDSAVERIFIER_H
+#define SULEGACYDSAVERIFIER_H
+
+BOOL SULegacyVerifyDSASignature(NSInputStream *stream, NSString *publicKey,
+    NSData *signature);
+
+#endif
diff --git a/Sparkle/SULegacyDSAVerifier.inc b/Sparkle/SULegacyDSAVerifier.inc
new file mode 100644
--- /dev/null
+++ b/Sparkle/SULegacyDSAVerifier.inc
@@ -0,0 +1,269 @@
+#import "SULegacyDSAVerifier.h"
+
+#if __MAC_OS_X_VERSION_MAX_ALLOWED < 1070
+
+#import "SULog.h"
+#include <CommonCrypto/CommonDigest.h>
+#include <Security/cssm.h>
+#include <Security/cssmapple.h>
+
+static CSSM_VERSION SUCSSMVersion = {2, 0};
+static const CSSM_GUID SUCSSMCaller = {
+    'S', 'p', 'a', {'r', 'k', 'l', 'e', 0, 0, 0, 0}
+};
+static CSSM_BOOL SUCSSMInitialised = CSSM_FALSE;
+
+static void *SUCSSMMalloc(CSSM_SIZE size, void *__unused context)
+{
+    return malloc(size);
+}
+
+static void SUCSSMFree(void *pointer, void *__unused context)
+{
+    free(pointer);
+}
+
+static void *SUCSSMRealloc(void *pointer, CSSM_SIZE size,
+    void *__unused context)
+{
+    return realloc(pointer, size);
+}
+
+static void *SUCSSMCalloc(uint32 count, CSSM_SIZE size,
+    void *__unused context)
+{
+    return calloc(count, size);
+}
+
+static CSSM_API_MEMORY_FUNCS SUCSSMMemoryFunctions = {
+    SUCSSMMalloc, SUCSSMFree, SUCSSMRealloc, SUCSSMCalloc, NULL
+};
+
+static NSObject *SUCSSMLock(void)
+{
+    static NSObject *lock;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        lock = [[NSObject alloc] init];
+    });
+    return lock;
+}
+
+static NSInteger SULegacyBase64Value(unichar character)
+{
+    if (character >= 'A' && character <= 'Z') {
+        return character - 'A';
+    }
+    if (character >= 'a' && character <= 'z') {
+        return character - 'a' + 26;
+    }
+    if (character >= '0' && character <= '9') {
+        return character - '0' + 52;
+    }
+    if (character == '+') {
+        return 62;
+    }
+    if (character == '/') {
+        return 63;
+    }
+    return -1;
+}
+
+static NSData *SULegacyDataFromStrictBase64String(NSString *string)
+{
+    if ([string length] == 0 || [string length] % 4 != 0) {
+        return nil;
+    }
+    NSMutableData *data = [NSMutableData dataWithCapacity:
+        [string length] / 4 * 3];
+    NSUInteger length = [string length];
+    for (NSUInteger index = 0; index < length; index += 4) {
+        unichar characters[4];
+        for (NSUInteger offset = 0; offset < 4; offset++) {
+            characters[offset] = [string characterAtIndex:index + offset];
+        }
+        BOOL finalBlock = index + 4 == length;
+        BOOL hasThirdPadding = characters[2] == '=';
+        BOOL hasFourthPadding = characters[3] == '=';
+        if (characters[0] == '=' || characters[1] == '=' ||
+                hasThirdPadding && !hasFourthPadding ||
+                (hasThirdPadding || hasFourthPadding) && !finalBlock) {
+            return nil;
+        }
+        NSInteger values[4] = {0, 0, 0, 0};
+        for (NSUInteger offset = 0; offset < 4; offset++) {
+            if (characters[offset] == '=') {
+                continue;
+            }
+            values[offset] = SULegacyBase64Value(characters[offset]);
+            if (values[offset] < 0) {
+                return nil;
+            }
+        }
+        if (hasThirdPadding && (values[1] & 15) != 0) {
+            return nil;
+        }
+        if (!hasThirdPadding && hasFourthPadding && (values[2] & 3) != 0) {
+            return nil;
+        }
+        uint8_t bytes[3];
+        bytes[0] = (uint8_t)((values[0] << 2) | (values[1] >> 4));
+        bytes[1] = (uint8_t)((values[1] << 4) | (values[2] >> 2));
+        bytes[2] = (uint8_t)((values[2] << 6) | values[3]);
+        [data appendBytes:bytes length:hasThirdPadding ? 1 :
+            (hasFourthPadding ? 2 : 3)];
+    }
+    return data;
+}
+
+static NSData *SUDSAKeyData(NSString *publicKey)
+{
+    if ([publicKey length] == 0) {
+        return nil;
+    }
+    NSString *body = [publicKey stringByReplacingOccurrencesOfString:
+        @"-----BEGIN PUBLIC KEY-----" withString:@""];
+    body = [body stringByReplacingOccurrencesOfString:
+        @"-----END PUBLIC KEY-----" withString:@""];
+    NSArray *lines = [body componentsSeparatedByCharactersInSet:
+        [NSCharacterSet newlineCharacterSet]];
+    NSMutableArray *trimmedLines = [NSMutableArray arrayWithCapacity:
+        [lines count]];
+    for (NSString *line in lines) {
+        NSString *trimmed = [line stringByTrimmingCharactersInSet:
+            [NSCharacterSet whitespaceAndNewlineCharacterSet]];
+        if ([trimmed length] != 0) {
+            [trimmedLines addObject:trimmed];
+        }
+    }
+    return SULegacyDataFromStrictBase64String(
+        [trimmedLines componentsJoinedByString:@""]);
+}
+
+static CSSM_CSP_HANDLE SUCSSMAttach(void)
+{
+    if (!SUCSSMInitialised) {
+        CSSM_PVC_MODE policy = CSSM_PVC_NONE;
+        CSSM_RETURN result = CSSM_Init(&SUCSSMVersion,
+            CSSM_PRIVILEGE_SCOPE_NONE, &SUCSSMCaller,
+            CSSM_KEY_HIERARCHY_NONE, &policy, NULL);
+        if (result != CSSM_OK) {
+            return CSSM_INVALID_HANDLE;
+        }
+        SUCSSMInitialised = CSSM_TRUE;
+    }
+    if (CSSM_ModuleLoad(&gGuidAppleCSP, CSSM_KEY_HIERARCHY_NONE,
+            NULL, NULL) != CSSM_OK) {
+        return CSSM_INVALID_HANDLE;
+    }
+    CSSM_CSP_HANDLE handle = CSSM_INVALID_HANDLE;
+    CSSM_RETURN result = CSSM_ModuleAttach(&gGuidAppleCSP,
+        &SUCSSMVersion, &SUCSSMMemoryFunctions, 0, CSSM_SERVICE_CSP, 0,
+        CSSM_KEY_HIERARCHY_NONE, NULL, 0, NULL, &handle);
+    if (result != CSSM_OK) {
+        CSSM_ModuleUnload(&gGuidAppleCSP, NULL, NULL);
+        return CSSM_INVALID_HANDLE;
+    }
+    return handle;
+}
+
+static void SUCSSMDetach(CSSM_CSP_HANDLE handle)
+{
+    if (handle != CSSM_INVALID_HANDLE) {
+        CSSM_ModuleDetach(handle);
+        CSSM_ModuleUnload(&gGuidAppleCSP, NULL, NULL);
+    }
+}
+
+static NSData *SUSHA1Digest(NSInputStream *stream)
+{
+    [stream open];
+    CC_SHA1_CTX context;
+    CC_SHA1_Init(&context);
+    uint8_t buffer[4096];
+    for (;;) {
+        NSInteger count = [stream read:buffer maxLength:sizeof(buffer)];
+        if (count < 0) {
+            [stream close];
+            return nil;
+        }
+        if (count == 0) {
+            break;
+        }
+        CC_SHA1_Update(&context, buffer, (CC_LONG)count);
+    }
+    [stream close];
+    NSMutableData *digest = [NSMutableData dataWithLength:CC_SHA1_DIGEST_LENGTH];
+    CC_SHA1_Final([digest mutableBytes], &context);
+    return [digest copy];
+}
+
+static BOOL SUCSSMVerify(CSSM_CSP_HANDLE handle, NSData *keyData,
+    NSData *digest, NSData *signature)
+{
+    CSSM_KEY key;
+    memset(&key, 0, sizeof(key));
+    key.KeyHeader.HeaderVersion = CSSM_KEYHEADER_VERSION;
+    key.KeyHeader.CspId = SUCSSMCaller;
+    key.KeyHeader.BlobType = CSSM_KEYBLOB_RAW;
+    key.KeyHeader.Format = CSSM_KEYBLOB_RAW_FORMAT_X509;
+    key.KeyHeader.AlgorithmId = CSSM_ALGID_DSA;
+    key.KeyHeader.KeyClass = CSSM_KEYCLASS_PUBLIC_KEY;
+    key.KeyHeader.KeyAttr = CSSM_KEYATTR_EXTRACTABLE;
+    key.KeyHeader.KeyUsage = CSSM_KEYUSE_ANY;
+    key.KeyData.Data = (uint8 *)[keyData bytes];
+    key.KeyData.Length = (CSSM_SIZE)[keyData length];
+
+    CSSM_KEY_SIZE keySize;
+    if (CSSM_QueryKeySizeInBits(handle, CSSM_INVALID_HANDLE, &key,
+            &keySize) != CSSM_OK) {
+        return NO;
+    }
+    key.KeyHeader.LogicalKeySizeInBits = keySize.LogicalKeySizeInBits;
+
+    CSSM_CC_HANDLE signatureContext = CSSM_INVALID_HANDLE;
+    if (CSSM_CSP_CreateSignatureContext(handle, CSSM_ALGID_SHA1WithDSA,
+            NULL, &key, &signatureContext) != CSSM_OK) {
+        return NO;
+    }
+    CSSM_DATA digestData = {
+        (CSSM_SIZE)[digest length], (uint8 *)[digest bytes]
+    };
+    CSSM_DATA signatureData = {
+        (CSSM_SIZE)[signature length], (uint8 *)[signature bytes]
+    };
+    BOOL valid = CSSM_VerifyData(signatureContext, &digestData, 1,
+        CSSM_ALGID_NONE, &signatureData) == CSSM_OK;
+    CSSM_DeleteContext(signatureContext);
+    return valid;
+}
+
+BOOL SULegacyVerifyDSASignature(NSInputStream *stream, NSString *publicKey,
+    NSData *signature)
+{
+    if (stream == nil || [publicKey length] == 0 || [signature length] == 0) {
+        return NO;
+    }
+    NSData *keyData = SUDSAKeyData(publicKey);
+    if ([keyData length] == 0) {
+        SULog(SULogLevelError, @"Public DSA key could not be decoded");
+        return NO;
+    }
+    @synchronized (SUCSSMLock()) {
+        CSSM_CSP_HANDLE handle = SUCSSMAttach();
+        if (handle == CSSM_INVALID_HANDLE) {
+            SULog(SULogLevelError, @"Apple CSSM provider could not be attached");
+            return NO;
+        }
+        NSData *digest = SUSHA1Digest(stream);
+        BOOL valid = digest != nil && SUCSSMVerify(handle, keyData, digest,
+            signature);
+        SUCSSMDetach(handle);
+        if (!valid) {
+            SULog(SULogLevelError, @"DSA signature does not match");
+        }
+        return valid;
+    }
+}
+
+#endif
