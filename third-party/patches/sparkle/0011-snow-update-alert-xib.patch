+    if (self)
+    {
+        self.completionBlock = block;
+        host = aHost;
+        updateItem = item;
+        _httpHeaders = httpHeaders;
+        _userAgent = userAgent;
+        [self setShouldCascadeWindows:NO];
+    }
+    return self;
