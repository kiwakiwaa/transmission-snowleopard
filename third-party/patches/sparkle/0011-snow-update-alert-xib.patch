+//
+//  SULegacyXIBCompatibility.h
+//  Sparkle
+//
+//  Runtime properties that Xcode 3 cannot retain in legacy XIB archives.
+//
+
+
+#import <AppKit/AppKit.h>
+
+NS_INLINE void SUConfigureLegacyPermissionPromptTable(NSTableView *tableView)
+{
+    NSScrollView *scrollView = [tableView enclosingScrollView];
+    [[scrollView horizontalScroller] setWantsLayer:YES];
+    [[scrollView verticalScroller] setWantsLayer:YES];
+}
+
+
+NS_INLINE NSString *SULegacyObservedKeyPath(id object, NSString *binding)
+{
+    return [[object infoForBinding:binding] objectForKey:NSObservedKeyPathKey];
+}
+
+NS_INLINE NSView *SULegacyViewBoundToKeyPath(NSView *contentView,
+    NSString *keyPath)
+{
+    for (NSView *view in [contentView subviews]) {
+        if ([[SULegacyObservedKeyPath(view, NSValueBinding) description]
+            isEqualToString:keyPath]) {
+            return view;
+        }
+    }
+    return nil;
+}
+
+NS_INLINE void SUConfigureLegacyAutomaticAlert(NSWindow *window,
+    NSButton *installButton, NSButton *laterButton, NSButton *skipButton)
+{
+    NSView *contentView = [window contentView];
+    NSView *iconView = SULegacyViewBoundToKeyPath(contentView,
+        @"applicationIcon");
+    NSView *titleView = SULegacyViewBoundToKeyPath(contentView, @"titleText");
+    NSView *descriptionView = SULegacyViewBoundToKeyPath(contentView,
+        @"descriptionText");
+    NSView *automaticCheckBox = SULegacyViewBoundToKeyPath(contentView,
+        @"values.SUAutomaticallyUpdate");
+
+    CGFloat installWidth = MAX(156.0, ceil([[installButton cell] cellSize].width));
+    CGFloat laterWidth = MAX(118.0, ceil([[laterButton cell] cellSize].width));
+    CGFloat skipWidth = MAX(107.0, ceil([[skipButton cell] cellSize].width));
+    CGFloat contentWidth = MAX(616.0,
+        14.0 + installWidth + laterWidth + 100.0 + 100.0 + skipWidth);
+    [window setContentSize:NSMakeSize(contentWidth, 152.0)];
+    [window setFrameAutosaveName:@"SUAutomaticUpdateAlert"];
+    [window setHidesOnDeactivate:NO];
+
+    // AppKit 10.7 publishes FullScreenAuxiliary as collection bit 8.
+    if ((NSInteger)NSAppKitVersionNumber > 1038) {
+        [window setCollectionBehavior:[window collectionBehavior] | (1UL << 8)];
+    }
+
+    [iconView setFrame:NSMakeRect(23.0, 73.0, 64.0, 64.0)];
+    [titleView setFrame:NSMakeRect(105.0, 121.0,
+        contentWidth - 119.0, 16.0)];
+    [descriptionView setFrame:NSMakeRect(105.0, 99.0,
+        contentWidth - 123.0, 14.0)];
+    [automaticCheckBox setFrame:NSMakeRect(106.0, 58.0,
+        contentWidth - 127.0, 18.0)];
+    [installButton setFrame:NSMakeRect(contentWidth - 14.0 - installWidth,
+        12.0, installWidth, 32.0)];
+    [laterButton setFrame:NSMakeRect(NSMinX([installButton frame]) - laterWidth,
+        12.0, laterWidth, 32.0)];
+    [skipButton setFrame:NSMakeRect(100.0, 12.0, skipWidth, 32.0)];
+}
+
+NS_INLINE NSView *SUPrepareLegacyUpdateAlert(NSWindow *window,
+    NSBox *releaseNotesBox)
+{
+    NSView *contentView = [window contentView];
+    NSView *releaseNotesLabel = nil;
+    for (NSView *view in [contentView subviews]) {
+        if ([view isKindOfClass:[NSTextField class]] &&
+            [[SULegacyObservedKeyPath(view, NSHiddenBinding) description]
+                isEqualToString:@"showsReleaseNotes"]) {
+            releaseNotesLabel = view;
+            break;
+        }
+    }
+
+    NSView *container = [[NSView alloc] initWithFrame:
+        NSMakeRect(108.0, 73.0, 492.0, 235.0)];
+    [releaseNotesBox removeFromSuperview];
+    [releaseNotesLabel removeFromSuperview];
+    [container addSubview:releaseNotesBox];
+    [container addSubview:releaseNotesLabel];
+    [contentView addSubview:container];
+
+    [releaseNotesBox setFrame:NSMakeRect(0.0, 0.0, 492.0, 215.0)];
+    [releaseNotesLabel setFrame:NSMakeRect(-2.0, 221.0, 100.0, 14.0)];
+    [window setContentMinSize:NSMakeSize(550.0, 150.0)];
+    [window setHidesOnDeactivate:NO];
+    if ([window respondsToSelector:NSSelectorFromString(@"setIdentifier:")]) {
+        [window setValue:@"SUUpdateAlert" forKey:@"identifier"];
+    }
+    if ((NSInteger)NSAppKitVersionNumber > 1038) {
+        [window setCollectionBehavior:[window collectionBehavior] | (1UL << 8)];
+    }
+
+    NSView *iconView = SULegacyViewBoundToKeyPath(contentView,
+        @"applicationIcon");
+    [(NSImageView *)iconView setImageScaling:
+        NSImageScaleProportionallyUpOrDown];
+    NSView *titleView = SULegacyViewBoundToKeyPath(contentView, @"titleText");
+    NSTextFieldCell *titleCell = [(NSTextField *)titleView cell];
+    [titleCell setScrollable:YES];
+    [titleCell setUsesSingleLineMode:YES];
+    [titleCell setLineBreakMode:NSLineBreakByClipping];
+    return container;
+}
+
+NS_INLINE void SUConfigureLegacyUpdateAlert(NSWindow *window,
+    NSView *releaseNotesContainer, NSBox *releaseNotesBox,
+    NSTextField *descriptionField, NSButton *automaticButton,
+    NSButton *installButton, NSButton *laterButton, NSButton *skipButton,
+    BOOL showReleaseNotes, BOOL showAutomaticButton)
+{
+    NSView *contentView = [window contentView];
+    CGFloat installWidth = MAX(134.0,
+        ceil([[installButton cell] cellSize].width));
+    CGFloat laterWidth = MAX(137.0, ceil([[laterButton cell] cellSize].width));
+    CGFloat skipWidth = MAX(139.0, ceil([[skipButton cell] cellSize].width));
+    CGFloat contentWidth = MAX(620.0,
+        20.0 + installWidth + laterWidth + skipWidth + 124.0);
+    CGFloat contentHeight = showReleaseNotes ?
+        (showAutomaticButton ? 370.0 : 346.0) : 150.0;
+    [window setContentSize:NSMakeSize(contentWidth, contentHeight)];
+
+    NSView *iconView = SULegacyViewBoundToKeyPath(contentView,
+        @"applicationIcon");
+    NSView *titleView = SULegacyViewBoundToKeyPath(contentView, @"titleText");
+    CGFloat descriptionWidth = contentWidth - 128.0;
+    NSSize descriptionSize = [[descriptionField cell]
+        cellSizeForBounds:NSMakeRect(0.0, 0.0, descriptionWidth, 28.0)];
+    CGFloat descriptionHeight = MIN(28.0, MAX(14.0,
+        ceil(descriptionSize.height)));
+    CGFloat titleY = contentHeight - 32.0;
+    CGFloat descriptionY = titleY - 8.0 - descriptionHeight;
+
+    [iconView setFrame:NSMakeRect(22.0, contentHeight - 84.0, 64.0, 64.0)];
+    [titleView setFrame:NSMakeRect(106.0, titleY,
+        contentWidth - 128.0, 17.0)];
+    [descriptionField setFrame:NSMakeRect(106.0, descriptionY,
+        descriptionWidth, descriptionHeight)];
+
+    CGFloat installX = contentWidth - 13.0 - installWidth;
+    [installButton setFrame:NSMakeRect(installX, 12.0,
+        installWidth, 32.0)];
+    [laterButton setFrame:NSMakeRect(installX - laterWidth + 2.0, 12.0,
+        laterWidth, 32.0)];
+    [skipButton setFrame:NSMakeRect(102.0, 12.0, skipWidth, 32.0)];
+
+    if (showReleaseNotes) {
+        CGFloat containerBottom = showAutomaticButton ? 73.0 : 49.0;
+        CGFloat containerTop = descriptionY - 8.0;
+        [releaseNotesContainer setFrame:NSMakeRect(108.0, containerBottom,
+            contentWidth - 128.0, containerTop - containerBottom)];
+        [releaseNotesBox setFrame:NSMakeRect(0.0, 0.0,
+            NSWidth([releaseNotesContainer frame]),
+            NSHeight([releaseNotesContainer frame]) - 20.0)];
+        for (NSView *view in [releaseNotesContainer subviews]) {
+            if ([view isKindOfClass:[NSTextField class]]) {
+                [view setFrame:NSMakeRect(-2.0,
+                    NSHeight([releaseNotesContainer frame]) - 14.0,
+                    100.0, 14.0)];
+            }
+        }
+    }
+    if (showAutomaticButton) {
+        [automaticButton setFrame:NSMakeRect(108.0, 50.0,
+            contentWidth - 129.0, 16.0)];
+    }
+}
