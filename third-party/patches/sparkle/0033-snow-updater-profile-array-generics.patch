# Snow Leopard compatibility patch 0033
#
# Incompatibility: Foundation 10.6 does not declare NSArray or NSDictionary as
# lightweight-generic classes, so the updater's profile collections fail.
# Behaviour preserved: permission prompts and feed URLs receive, combine, and
# enumerate the same key/value dictionaries in the same order.
# History: 282f0ae5 changed profileInfo from NSArray solely to add generics.
# 9ae41fe4 similarly typed parameters and loop values to silence Xcode 10
# messaging warnings. Their parent implementations use the plain types below.
# Public API evidence: the 10.6 collection classes expose every selector used.
# Safety: only local compiler annotations change. Contents and operations do not.
diff --git a/Sparkle/SUUpdater.m b/Sparkle/SUUpdater.m
--- a/Sparkle/SUUpdater.m
+++ b/Sparkle/SUUpdater.m
@@ -242,7 +242,7 @@
     [[SUGlobalUpdateLock sharedLock] unlock];  // For safety, remove active lock if present in any case and not just when relaunching from an app update
     
     if (shouldPrompt) {
-        NSArray<NSDictionary<NSString *, NSString *> *> *profileInfo = [SUSystemProfiler systemProfileArrayForHost:self.host];
+        NSArray *profileInfo = [SUSystemProfiler systemProfileArrayForHost:self.host];
         // Always say we're sending the system profile here so that the delegate displays the parameters it would send.
         if ([self.delegate respondsToSelector:@selector(feedParametersForUpdater:sendingSystemProfile:)]) {
             profileInfo = [profileInfo arrayByAddingObjectsFromArray:[self.delegate feedParametersForUpdater:self sendingSystemProfile:YES]];
@@ -573,7 +573,7 @@
     const NSTimeInterval oneWeek = 60 * 60 * 24 * 7;
     sendingSystemProfile &= (-[lastSubmitDate timeIntervalSinceNow] >= oneWeek);
 
-    NSArray<NSDictionary<NSString *, NSString *> *> *parameters = @[];
+    NSArray *parameters = @[];
     if ([self.delegate respondsToSelector:@selector(feedParametersForUpdater:sendingSystemProfile:)]) {
         parameters = [parameters arrayByAddingObjectsFromArray:[self.delegate feedParametersForUpdater:self sendingSystemProfile:sendingSystemProfile]];
     }
@@ -586,7 +586,7 @@
 
     // Build up the parameterized URL.
     NSMutableArray *parameterStrings = [NSMutableArray array];
-    for (NSDictionary<NSString *, NSString *> *currentProfileInfo in parameters) {
+    for (NSDictionary *currentProfileInfo in parameters) {
         [parameterStrings addObject:[NSString stringWithFormat:@"%@=%@", escapeURLComponent([[currentProfileInfo objectForKey:@"key"] description]), escapeURLComponent([[currentProfileInfo objectForKey:@"value"] description])]];
     }
 
